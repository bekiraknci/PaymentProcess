{
  "ConnectionStrings": {
    "PaymentSystem": "Server=(localdb)\\MSSQLLocalDB;Database=PaymentSystem;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Jwt": {
    "Issuer": "PaymentSystem",
    "Audience": "PaymentSystem.Api",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 60
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "PaymentProcessing": {
    "WorkerCount": 2,
    "LeaseSeconds": 120,
    "PollIntervalSeconds": 10,
    "RecoveryBatchSize": 100,
    "QueueCapacity": 10000,
    "MaxAutomaticAttempts": 3,
    "RetryBaseDelayMinutes": 1
  },
  "RateLimiting": {
    "Enabled": true,
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "PaymentCreateBurst": 100,
    "PaymentCreatePerSecond": 50,
    "GlobalBurst": 500,
    "GlobalPerSecond": 200
  },
  "PaymentProvider": {
    "BaseUrl": "http://localhost:5100",
    "AttemptTimeoutSeconds": 5,
    "TotalTimeoutSeconds": 20,
    "MaxRetryAttempts": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
